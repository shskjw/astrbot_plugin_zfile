{
  "zfile_base_url": {
    "description": "ZFile 根地址 (例如 http://your-zfile.com/api)",
    "type": "string",
    "default": "http://127.0.0.1:8080/api"
  },
  "username": {
    "description": "管理员账号 (用于自动获取Token)",
    "type": "string",
    "default": "admin"
  },
  "password": {
    "description": "管理员密码",
    "type": "string",
    "default": "123456",
    "is_password": true
  },
  "default_storage_key": {
    "description": "默认存储源Key (如果不填，指令中需要指定)",
    "type": "string",
    "default": "local"
  },
  "admins": {
    "description": "管理员QQ/用户ID列表",
    "type": "list",
    "default": []
  },
  "permissions": {
    "description": "权限控制",
    "type": "object",
    "items": {
      "upload_enabled": { "type": "bool", "default": true },
      "upload_admin_only": { "type": "bool", "default": true },
      "download_enabled": { "type": "bool", "default": true },
      "download_admin_only": { "type": "bool", "default": false },
      "delete_enabled": { "type": "bool", "default": true },
      "delete_admin_only": { "type": "bool", "default": true }
    }
  }
}
